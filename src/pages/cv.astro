---
import "../styles/cv.css";

const title = "CV — Franklin Baca Campos";
const description =
  "Currículum vitae de Franklin Baca Campos, Ingeniero de Sistemas e Ingeniero de Software en Trujillo, Perú.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Franklin Baca Campos" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Action buttons -->
    <div class="cv-actions">
      <a href="/" aria-label="Volver al portafolio">← Portafolio</a>
      <button id="download-pdf" class="primary" aria-label="Descargar PDF">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span id="btn-text">Descargar PDF</span>
      </button>
    </div>

    <main>
      <article class="cv-sheet" id="cv-content">
        <!-- HEADER -->
        <header class="cv-header">
          <div class="cv-header-text">
            <h1>Franklin Baca Campos</h1>
            <p class="cv-tagline">Ingeniero de Sistemas · Ingeniero de Software</p>
            <p class="cv-contact">
              Trujillo, Perú &nbsp;•&nbsp; <a
                href="mailto:franklinbacacampos@gmail.com"
                >franklinbacacampos@gmail.com</a
              > &nbsp;•&nbsp; +51 941 225 240 &nbsp;•&nbsp; <a
                href="https://www.linkedin.com/in/franklinbacacampos/"
                target="_blank"
                rel="noopener noreferrer">linkedin</a
              > &nbsp;•&nbsp; <a
                href="https://github.com/breakcito"
                target="_blank"
                rel="noopener noreferrer">github</a
              >
            </p>
          </div>
          <img
            id="profile-photo"
            src="/hap.jpg"
            alt="Franklin Baca Campos"
            class="cv-photo"
          />
        </header>

        <!-- RESUMEN -->
        <section class="cv-section">
          <h2 class="cv-section-title">Resumen</h2>
          <p style="margin:0;font-size:9.6pt;line-height:1.35;color:#222">
            Ingeniero de Sistemas con experiencia desarrollando
            aplicaciones móviles y plataformas web empresariales. Diseño
            arquitecturas modulares y mantenibles enfocadas en rendimiento,
            pruebas y continuidad operativa.
          </p>
        </section>

        <!-- EXPERIENCIA -->
        <section class="cv-section">
          <h2 class="cv-section-title">Experiencia</h2>

          <div class="cv-item">
            <div class="cv-item-header">
              <span>Consorcio Minero Black Silver S.A.C</span>
              <span>Mar 2026 — Actualidad</span>
            </div>
            <div class="cv-item-sub">
              <em>Ingeniero de Software</em> · Trujillo, Perú
            </div>
            <ul class="cv-bullets">
              <li>
                Desarrollo del ERP minero para compras, distribución de insumos,
                control de almacenes y gestión de flota (uso, consumo, costos y
                alertas de mantenimiento preventivo).
              </li>
              <li>
                Implementación de los módulos de RRHH (contratos, adendas, horarios,
                asistencias, incidentes y reportes de planilla) y producción (tareo,
                extracción, análisis químicos y venta de mineral).
              </li>
              <li>
                Desarrollo de aplicación móvil en React Native para la solicitud y
                despacho de pedidos a almacén.
              </li>
            </ul>
          </div>

          <div class="cv-item">
            <div class="cv-item-header">
              <span>Corporación Copper Cave S.A.C</span>
              <span>Oct 2025 — May 2026</span>
            </div>
            <div class="cv-item-sub">
              <em>Analista Programador</em> · Trujillo, Perú
            </div>
            <ul class="cv-bullets">
              <li>
                Desarrollo de módulos para el control de ingresos, salidas, pesaje en
                balanza, guías de remisión y reportes diarios de planta.
              </li>
              <li>
                Migración de la base de datos histórica de operaciones a MySQL y
                automatización de reportes de facturación y asistencia.
              </li>
              <li>
                Implementación del control de accesos y permisos por roles para las
                áreas de planillas, facturación y operaciones.
              </li>
            </ul>
          </div>

          <div class="cv-item">
            <div class="cv-item-header">
              <span>Micro Service Group S.A.C</span>
              <span>Nov 2024 — Sept 2025</span>
            </div>
            <div class="cv-item-sub">
              <em>Full Stack Developer</em> · Lima, Perú
            </div>
            <ul class="cv-bullets">
              <li>
                Integración de facturación electrónica (facturas, boletas, notas de
                crédito y guías) conectada directamente a SUNAT mediante API en Laravel.
              </li>
              <li>
                Desarrollo y mantenimiento de módulos web y móviles (React y React Native)
                para el sistema comercial y punto de venta: inventarios, precios, caja y sucursales.
              </li>
              <li>
                Automatización del flujo de despliegue del ERP DATCORP y optimización
                de consultas en SQL Server para reportes contables y de ventas.
              </li>
            </ul>
          </div>
        </section>

        <!-- EDUCACIÓN -->
        <section class="cv-section">
          <h2 class="cv-section-title">Educación</h2>
          <div class="cv-item">
            <div class="cv-item-header">
              <span>Universidad Privada del Norte</span>
              <span>Mar 2022 — Dic 2026</span>
            </div>
            <div class="cv-item-sub">
              <em>Ingeniería de Sistemas Computacionales</em> · Trujillo, Perú ·
              10mo ciclo
            </div>
            <ul class="cv-bullets">
              <li>
                Tercio Superior de la Facultad de Ingeniería (Jul 2024) · Quinto Superior
                (Nov 2023)
              </li>
            </ul>
          </div>
        </section>

        <!-- HABILIDADES -->
        <section class="cv-section">
          <h2 class="cv-section-title">Habilidades Técnicas</h2>
          <div class="cv-grid-2">
            <div>
              <strong>Lenguajes:</strong> TypeScript, JavaScript, PHP, Python, C#, Java, C++, SQL
            </div>
            <div>
              <strong>Móvil y Web:</strong> React Native, Expo, React, Next.js, Redux, Zustand, Laravel, NestJS, FastAPI, .NET
            </div>
            <div>
              <strong>Arquitectura y Testing:</strong> Clean Architecture, Hexagonal, MVVM, MVI, Vertical Slice, Jest, JMeter
            </div>
            <div>
              <strong>Cloud, Datos y DevOps:</strong> Firebase, Azure, GCP, SQL Server, PostgreSQL, MySQL, Git, Docker, CI/CD
            </div>
            <div>
              <strong>Certificaciones:</strong> CCNA Network Analyst (Jul 2025), Junior Cybersecurity Analyst Cisco (Jun 2024)
            </div>
            <div>
              <strong>Idiomas:</strong> Español (nativo), Inglés B1 — WeTALK UPC (Mar 2025)
            </div>
          </div>
        </section>
      </article>
    </main>

    <script>
      import pdfMakeUrl from "pdfmake/build/pdfmake.min.js?url";
      import vfsFontsUrl from "pdfmake/build/vfs_fonts.js?url";
      import QRCode from "qrcode";

      const PORTFOLIO_URL = "https://franklincampos.com/";

      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const existing = document.querySelector(
            `script[data-pdfmake-src="${src}"]`
          );
          if (existing) {
            if (existing.dataset.loaded === "true") resolve();
            else existing.addEventListener("load", resolve);
            return;
          }
          const s = document.createElement("script");
          s.src = src;
          s.dataset.pdfmakeSrc = src;
          s.onload = () => {
            s.dataset.loaded = "true";
            resolve();
          };
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }

      async function getPdfMake() {
        // @ts-ignore
        if (!window.pdfMake) {
          await loadScript(pdfMakeUrl);
        }
        // @ts-ignore
        if (!window.pdfMake || !window.pdfMake.vfs) {
          await loadScript(vfsFontsUrl);
        }
        // @ts-ignore
        const pdfMake = window.pdfMake;
        if (!pdfMake) throw new Error("pdfMake no se cargó");
        return pdfMake;
      }

      function hr() {
        return {
          canvas: [
            {
              type: "line",
              x1: 0,
              y1: 0,
              x2: 515,
              y2: 0,
              lineWidth: 0.7,
              lineColor: "#000",
            },
          ],
          margin: [0, 1, 0, 3],
        };
      }

      function buildDocDefinition(qrDataUrl, photoDataUrl) {
        return {
          pageSize: "LETTER",
          pageMargins: [36, 36, 36, 50],

          footer: function (currentPage, pageCount) {
            return {
              columns: [
                {
                  image: qrDataUrl,
                  width: 28,
                  margin: [36, 0, 0, 0],
                },
                {
                  stack: [
                    {
                      text: "franklincampos.com",
                      fontSize: 7.5,
                      color: "#666",
                    },
                    {
                      text: `Página ${currentPage} de ${pageCount}`,
                      fontSize: 7.5,
                      color: "#666",
                      margin: [0, 1, 0, 0],
                    },
                  ],
                  alignment: "right",
                  margin: [0, 6, 36, 0],
                },
              ],
            };
          },

          content: [
            // Header
            {
              columns: [
                {
                  width: "*",
                  stack: [
                    {
                      text: "Franklin Baca Campos",
                      style: "name",
                      alignment: "center",
                    },
                    {
                      text: "Ingeniero de Sistemas Computacionales",
                      style: "tagline",
                      alignment: "center",
                      margin: [0, 1, 0, 0],
                    },
                    {
                      text:
                        "Trujillo, Perú  ·  franklinbacacampos@gmail.com  ·  +51 941 225 240  ·  linkedin.com/in/franklinbacacampos  ·  github.com/breakcito",
                      style: "contact",
                      alignment: "center",
                      margin: [0, 3, 0, 0],
                    },
                  ],
                },
                photoDataUrl
                  ? {
                      image: photoDataUrl,
                      width: 50,
                      height: 50,
                      alignment: "right",
                    }
                  : { text: "" },
              ],
              margin: [0, 0, 0, 6],
            },

            hr(),

            // Resumen
            {
              text: "RESUMEN",
              style: "sectionTitle",
              margin: [0, 4, 0, 3],
            },
            {
              text:
                "Ingeniero de Sistemas con experiencia desarrollando aplicaciones móviles y plataformas web empresariales. Diseño arquitecturas modulares y mantenibles enfocadas en rendimiento, pruebas y continuidad operativa.",
              fontSize: 9.5,
              margin: [0, 0, 0, 6],
            },

            hr(),

            // Experiencia
            {
              text: "EXPERIENCIA",
              style: "sectionTitle",
              margin: [0, 4, 0, 3],
            },

            // Black Silver
            {
              columns: [
                {
                  text: [
                    { text: "Consorcio Minero Black Silver S.A.C", bold: true },
                  ],
                  fontSize: 10,
                },
                {
                  text: "Mar 2026 — Actualidad",
                  alignment: "right",
                  fontSize: 9,
                },
              ],
              margin: [0, 0, 0, 1],
            },
            {
              text: "Ingeniero de Software · Trujillo, Perú",
              fontSize: 9.3,
              italics: true,
              margin: [0, 0, 0, 2],
            },
            {
              ul: [
                "Desarrollo del ERP minero para compras, distribución de insumos, control de almacenes y gestión de flota (uso, consumo, costos y alertas de mantenimiento preventivo).",
                "Implementación de los módulos de RRHH (contratos, adendas, horarios, asistencias, incidentes y reportes de planilla) y producción (tareo, extracción, análisis químicos y venta de mineral).",
                "Desarrollo de aplicación móvil en React Native para la solicitud y despacho de pedidos a almacén.",
              ],
              fontSize: 9.4,
              margin: [0, 0, 0, 5],
            },

            // Copper Cave
            {
              columns: [
                {
                  text: [
                    { text: "Corporación Copper Cave S.A.C", bold: true },
                  ],
                  fontSize: 10,
                },
                {
                  text: "Oct 2025 — May 2026",
                  alignment: "right",
                  fontSize: 9,
                },
              ],
              margin: [0, 0, 0, 1],
            },
            {
              text: "Analista Programador · Trujillo, Perú",
              fontSize: 9.3,
              italics: true,
              margin: [0, 0, 0, 2],
            },
            {
              ul: [
                "Desarrollo de módulos para el control de ingresos, salidas, pesaje en balanza, guías de remisión y reportes diarios de planta.",
                "Migración de la base de datos histórica de operaciones a MySQL y automatización de reportes de facturación y asistencia.",
                "Implementación del control de accesos y permisos por roles para las áreas de planillas, facturación y operaciones.",
              ],
              fontSize: 9.4,
              margin: [0, 0, 0, 5],
            },

            // Micro Service Group
            {
              columns: [
                { text: [{ text: "Micro Service Group S.A.C", bold: true }], fontSize: 10 },
                {
                  text: "Nov 2024 — Sept 2025",
                  alignment: "right",
                  fontSize: 9,
                },
              ],
              margin: [0, 0, 0, 1],
            },
            {
              text: "Full Stack Developer · Lima, Perú",
              fontSize: 9.3,
              italics: true,
              margin: [0, 0, 0, 2],
            },
            {
              ul: [
                "Integración de facturación electrónica (facturas, boletas, notas de crédito y guías) conectada directamente a SUNAT mediante API en Laravel.",
                "Desarrollo y mantenimiento de módulos web y móviles (React y React Native) para el sistema comercial y punto de venta: inventarios, precios, caja y sucursales.",
                "Automatización del flujo de despliegue del ERP DATCORP y optimización de consultas en SQL Server para reportes contables y de ventas.",
              ],
              fontSize: 9.4,
              margin: [0, 0, 0, 5],
            },

            hr(),

            // Educación
            {
              text: "EDUCACIÓN",
              style: "sectionTitle",
              margin: [0, 4, 0, 3],
            },
            {
              columns: [
                {
                  text: [
                    { text: "Universidad Privada del Norte", bold: true },
                  ],
                  fontSize: 10,
                },
                {
                  text: "Mar 2022 — Dic 2026",
                  alignment: "right",
                  fontSize: 9,
                },
              ],
              margin: [0, 0, 0, 1],
            },
            {
              text: "Ingeniería de Sistemas Computacionales · Trujillo, Perú · 10mo ciclo (último ciclo)",
              fontSize: 9.3,
              italics: true,
              margin: [0, 0, 0, 2],
            },
            {
              text: "Tercio Superior de la Facultad de Ingeniería (Jul 2024) · Quinto Superior (Nov 2023)",
              fontSize: 9.3,
              margin: [0, 0, 0, 6],
            },

            hr(),

            // Habilidades
            {
              text: "HABILIDADES TÉCNICAS",
              style: "sectionTitle",
              margin: [0, 4, 0, 3],
            },
            {
              columns: [
                {
                  width: "*",
                  stack: [
                    {
                      text: [
                        { text: "Lenguajes: ", bold: true },
                        "TypeScript, JavaScript, PHP, Python, C#, Java, C++, SQL",
                      ],
                      fontSize: 9.2,
                      margin: [0, 0, 0, 2],
                    },
                    {
                      text: [
                        { text: "Móvil y Web: ", bold: true },
                        "React Native, Expo, React, Next.js, Redux, Zustand, Laravel, NestJS, FastAPI, .NET",
                      ],
                      fontSize: 9.2,
                      margin: [0, 0, 0, 2],
                    },
                    {
                      text: [
                        { text: "Arquitectura y Testing: ", bold: true },
                        "Clean Architecture, Hexagonal, MVVM, MVI, Vertical Slice, Jest, JMeter",
                      ],
                      fontSize: 9.2,
                    },
                  ],
                },
                {
                  width: "*",
                  stack: [
                    {
                      text: [
                        { text: "Cloud, Datos y DevOps: ", bold: true },
                        "Firebase, Azure, GCP, SQL Server, PostgreSQL, MySQL, Git, Docker, CI/CD",
                      ],
                      fontSize: 9.2,
                      margin: [0, 0, 0, 2],
                    },
                    {
                      text: [
                        { text: "Certificaciones: ", bold: true },
                        "CCNA Network Analyst (Jul 2025), Junior Cybersecurity Analyst Cisco (Jun 2024)",
                      ],
                      fontSize: 9.2,
                      margin: [0, 0, 0, 2],
                    },
                    {
                      text: [
                        { text: "Idiomas: ", bold: true },
                        "Español (nativo), Inglés B1 — WeTALK UPC (Mar 2025)",
                      ],
                      fontSize: 9.2,
                    },
                  ],
                },
              ],
              columnGap: 10,
            },
          ],

          styles: {
            name: { fontSize: 20, bold: true, color: "#000" },
            tagline: { fontSize: 10, color: "#444", italics: true },
            contact: { fontSize: 9, color: "#333" },
            sectionTitle: {
              fontSize: 10,
              bold: true,
              alignment: "center",
              characterSpacing: 1,
            },
          },

          defaultStyle: {
            font: "Roboto",
            fontSize: 9.5,
            lineHeight: 1.25,
            color: "#000",
          },
        };
      }

      async function imageToDataUrl(src) {
        const res = await fetch(src);
        const blob = await res.blob();
        return await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve(reader.result);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
      }

      async function generatePdf() {
        const btn = document.getElementById("download-pdf");
        const btnText = document.getElementById("btn-text");
        const originalText = btnText.textContent;
        btnText.textContent = "Generando…";
        btn.disabled = true;

        try {
          const pdfMake = await getPdfMake();

          const qrDataUrl = await QRCode.toDataURL(PORTFOLIO_URL, {
            margin: 1,
            width: 200,
            errorCorrectionLevel: "M",
            color: { dark: "#000000", light: "#FFFFFF" },
          });

          const photoDataUrl = await imageToDataUrl("/hap.jpg").catch(() => null);

          const docDefinition = buildDocDefinition(qrDataUrl, photoDataUrl);
          pdfMake
            .createPdf(docDefinition)
            .download("@franklin-baca-campos.pdf");
        } catch (err) {
          console.error("PDF generation failed:", err);
          alert("Hubo un error al generar el PDF. Revisa la consola.");
        } finally {
          btnText.textContent = originalText;
          btn.disabled = false;
        }
      }

      document
        .getElementById("download-pdf")
        ?.addEventListener("click", generatePdf);
    </script>
  </body>
</html>